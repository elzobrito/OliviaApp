{
    "name": "elzobrito/olivia-framework",
    "description": "Olivia PHP framework kernel, in-tree libraries and application skeleton",
    "license": "MIT",
    "authors": [
        {
            "name": "elzobrito",
            "email": "elzo.filho@etec.sp.gov.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "OliviaApp\\": "app/",
            "OliviaLib\\": "lib/",
            "OliviaPublico\\": "publico/",
            "OliviaRouter\\": "src/router/",
            "OliviaPagination\\": "src/pagination/",
            "Oliviapdf\\": "src/pdf/",
            "OliviaUpload\\": "src/upload/",
            "OliviaDownload\\": "src/download/",
            "OliviaDatabaseLibrary\\": "src/database/",
            "OliviaDatabaseModel\\": "src/database-model/",
            "OliviaDatabaseConfig\\": "src/database-config/",
            "OliviaCache\\": "src/cache/"
        }
    },
    "require": {
        "php": ">=8.2 <8.6",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "fpdf/fpdf": "^1.82",
        "ramsey/uuid": "^4.0"
    },
    "replace": {
        "elzobrito/olivia-cache": "*",
        "elzobrito/olivia-databaselibrary": "*",
        "elzobrito/olivia-force-download": "*",
        "elzobrito/olivia-pagination": "*",
        "elzobrito/olivia-pdf": "*",
        "elzobrito/olivia-router": "*",
        "elzobrito/olivia-upload-file": "*"
    }
}
