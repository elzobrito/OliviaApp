# Olivia Framework — exemplo de configuração (OLIVIA-QA-317)
#
# Copie para .env (que está no .gitignore) e ajuste. Este arquivo não tem segredo real:
# a senha vem de DB_PASSWORD_FILE (secret em arquivo) ou de DB_PASSWORD num .env local.
# O framework lê só variáveis de ambiente; o .env é carregado pelo Docker Compose
# (ou pelo seu gerenciador de processos), não pelo PHP.

# --- Aplicação ------------------------------------------------------------
APP_DEBUG=false
# Proxies cujo X-Forwarded-Proto é confiável (IPs ou CIDRs, separados por vírgula).
# OLIVIA_TRUSTED_PROXIES=10.0.0.0/8
# Diretório de uploads, fora do webroot. Padrão: <raiz>/storage/uploads
# OLIVIA_UPLOAD_DIR=/var/www/storage/uploads
# Chave do Crypto (32 bytes em base64). Gere com: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# OLIVIA_APP_KEY=

# --- Banco: conexão 'default' ---------------------------------------------
# Opção 1: DSN (sem usuário nem senha dentro do DSN; isso é recusado).
OLIVIA_DB_DSN=mysql:host=db;port=3306;dbname=olivia
# Opção 2: variáveis separadas (use uma das duas opções, não as duas).
# DB_DRIVER=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=olivia

# Usuário da aplicação, com privilégio mínimo (SELECT, INSERT, UPDATE, DELETE). Veja o README.
DB_USERNAME=olivia_app
# Senha: prefira o arquivo de secret. Defina só uma das duas (as duas juntas falham).
DB_PASSWORD_FILE=/run/secrets/db_password
# DB_PASSWORD=

# TLS: ligado por padrão para host fora do loopback, com verificação do certificado.
# OLIVIA_DB_SSL_CA=/etc/ssl/certs/db-ca.pem
# Desligar TLS para host remoto exige as duas linhas abaixo (só em rede privada confiável):
# OLIVIA_DB_SSL=false
# OLIVIA_DB_ALLOW_INSECURE=true

# --- Banco: conexão prefixada 'migracoes' (opcional) ------------------------
# Declarada em lib/Database.php como DatabaseConfig::fromEnvironment('MIG_').
# Usuário separado, com DDL, usado só por scripts de migração (nunca pela app web).
# MIG_OLIVIA_DB_DSN=mysql:host=db;port=3306;dbname=olivia
# MIG_DB_USERNAME=olivia_migrator
# MIG_DB_PASSWORD_FILE=/run/secrets/db_migrator_password
